#!/bin/bash

# 获取项目根目录
PROJECT_ROOT=$(git rev-parse --show-toplevel)

# 加载环境变量文件
ENV_FILE="$PROJECT_ROOT/.deploy.env"

if [ ! -f "$ENV_FILE" ]; then
    echo "❌ 错误: 找不到 .deploy.env 文件，请先在项目根目录创建！"
    exit 1
fi

# 读取环境变量（排除注释和空行）
source "$ENV_FILE"

# 检查必要变量是否存在
if [ -z "$SERVER_HOST" ] || [ -z "$TARGET_PATH" ]; then
    echo "❌ 错误: .deploy.env 中缺少 SERVER_HOST 或 TARGET_PATH 定义！"
    exit 1
fi

# 本地 book 文件夹路径
BOOK_SRC="$PROJECT_ROOT/book"

# 检查 book 目录是否存在
if [ ! -d "$BOOK_SRC" ]; then
    echo "⚠️ 警告: book/ 目录不存在，请先执行 mdbook build"
    exit 1
fi

# 目标完整路径（组合 SERVER_HOST 和 TARGET_PATH）
TARGET="${SERVER_HOST}:${TARGET_PATH}"

# 执行部署
echo "🚀 正在部署 book/ 到 $SERVER_HOST ..."
rsync -avz --delete "$BOOK_SRC/" "$TARGET"

if [ $? -eq 0 ]; then
    echo "✅ 部署成功！网站根目录已更新"
else
    echo "❌ 部署失败，请检查网络或 SSH 连接"
    exit 1
fi