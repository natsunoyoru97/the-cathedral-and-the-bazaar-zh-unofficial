#!/bin/bash

# 获取项目根目录
PROJECT_ROOT=$(git rev-parse --show-toplevel)

# 加载环境变量文件
ENV_FILE="$PROJECT_ROOT/.deploy.env"

if [ ! -f "$ENV_FILE" ]; then
    echo "❌ 错误: 找不到 .deploy.env 文件"
    exit 1
fi

source "$ENV_FILE"

if [ -z "$SERVER_HOST" ] || [ -z "$TARGET_PATH" ]; then
    echo "❌ 错误: .deploy.env 中缺少 SERVER_HOST 或 TARGET_PATH"
    exit 1
fi

BOOK_SRC="$PROJECT_ROOT/book"

if [ ! -d "$BOOK_SRC" ]; then
    echo "⚠️ 警告: book/ 目录不存在，请先执行 mdbook build"
    exit 1
fi

# 1. 先进入项目根目录
cd "$PROJECT_ROOT"

# 2. 目标路径组合
TARGET="${SERVER_HOST}:${TARGET_PATH}"

# 3. 使用相对路径 "book/" 作为源（注意结尾的 / 表示同步内容，不包含目录本身）
echo "🚀 正在部署 book/ 到 $SERVER_HOST ..."
rsync -avz --delete --exclude=.user.ini -e "ssh -T -o LogLevel=ERROR" book/ "$TARGET" < /dev/null

if [ $? -eq 0 ]; then
    echo "✅ 部署成功！网站根目录已更新"
else
    echo "❌ 部署失败，请检查网络或 SSH 连接"
    exit 1
fi